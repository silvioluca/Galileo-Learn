# Configurazione Firebase (Auth + Firestore).
# Senza questi valori il sito funziona comunque in modalità ospite
# (progressi salvati in localStorage sul dispositivo).
#
# Crea un progetto su https://console.firebase.google.com, abilita:
#  - Authentication -> Sign-in method -> Email/Password e Google
#  - Firestore Database (modalità produzione o test)
# poi copia questo file in .env.local e incolla i valori della tua web app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
